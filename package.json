{
  "name": "andromeda-espacial",
  "displayName": "Andromeda Espacial",
  "description": "Tema oscuro basado en Andromeda, con cinco variantes y una edición Sith roja para Antigravity IDE y VS Code.",
  "version": "1.1.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "patch": "node scripts/patch-neon.mjs",
    "patch:animated": "node scripts/patch-neon.mjs --animated",
    "patch:overlay": "node scripts/patch-neon.mjs --terminal-overlay",
    "restore": "node scripts/patch-neon.mjs --restore",
    "package": "node scripts/package-theme.mjs"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#23262E",
    "theme": "dark"
  },
  "publisher": "miandromeda",
  "engines": {
    "vscode": "^1.43.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Andromeda Espacial",
        "uiTheme": "vs-dark",
        "path": "./themes/Andromeda-color-theme.json"
      },
      {
        "label": "Andromeda Espacial Bordered",
        "uiTheme": "vs-dark",
        "path": "./themes/Andromeda-color-theme-bordered.json"
      },
      {
        "label": "Andromeda Espacial Italic Bordered",
        "uiTheme": "vs-dark",
        "path": "./themes/Andromeda-italic-color-theme-bordered.json"
      },
      {
        "label": "Andromeda Espacial Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/Andromeda-italic-color-theme.json"
      },
      {
        "label": "Andromeda Sith",
        "uiTheme": "vs-dark",
        "path": "./themes/Andromeda-sith-color-theme.json"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dantegaspar/andromeda-espacial.git"
  },
  "homepage": "https://github.com/dantegaspar/andromeda-espacial#readme",
  "bugs": {
    "url": "https://github.com/dantegaspar/andromeda-espacial/issues"
  },
  "keywords": [
    "theme",
    "dark",
    "andromeda",
    "space",
    "antigravity"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  }
}
