  "tokenColors": [
    {
      "settings": {
        "foreground": "#F0DDE1",
        "background": "#140E12"
      }
    },
    {
      "name": "Comment color",
      "scope": [
        "comment",
        "markup.quote.markdown",
        "meta.diff",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#9C7D86"
      }
    },
    {
      "name": "Text Color",
      "scope": [
        "meta.template.expression.js",
        "constant.name.attribute.tag.jade",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.string.begin.markdown"
      ],
      "settings": {
        "foreground": "#F0DDE1"
      }
    },
    {
      "name": "Sith Crimson Variables",
      "scope": [
        "variable",
        "support.variable",
        "entity.name.tag.yaml",
        "constant.character.entity.html",
        "source.css entity.name.tag.reference",
        "beginning.punctuation.definition.list.markdown",
        "source.css entity.other.attribute-name.parent-selector",
        "meta.structure.dictionary.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#FF536B"
      }
    },
    {
      "name": "Orange",
      "scope": [
        "markup.bold",
        "constant.numeric",
        "meta.group.regexp",
        "constant.other.php",
        "support.constant.ext.php",
        "constant.other.class.php",
        "support.constant.core.php",
        "fenced_code.block.language",
        "constant.other.caps.python",
        "support.type.exception.python",
        "source.css keyword.other.unit",
        "variable.other.object.js",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.type.property-name.js",
        "support.type.property-name.ts",
        "support.variable.property",
        "entity.name.variable.property",
        "meta.field.declaration"
      ],
      "settings": {
        "foreground": "#FFB09E"
      }
    },
    {
      "name": "Yellow",
      "scope": [
        "markup.list",
        "text.xml string",
        "entity.name.type",
        "support.function",
        "entity.other.attribute-name",
        "meta.at-rule.extend",
        "entity.name.function",
        "entity.other.inherited-class",
        "entity.other.keyframe-offset.css",
        "text.html.markdown string.quoted",
        "meta.function-call.generic.python",
        "meta.at-rule.extend support.constant",
        "entity.other.attribute-name.class.jade",
        "source.css entity.other.attribute-name",
        "text.xml punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#F7CCD5"
      }
    },
    {
      "name": "Pink",
      "scope": [
        "markup.heading",
        "variable.language.this.js",
        "variable.language.special.self.python",
        "variable.language.this",
        "variable.language.this.ts",
        "variable.language.super",
        "variable.language.super.js",
        "variable.language.super.ts"
      ],
      "settings": {
        "foreground": "#FF8297"
      }
    },
    {
      "name": "Hot Pink",
      "scope": [
        "punctuation.definition.interpolation",
        "punctuation.section.embedded.end.php",
        "punctuation.section.embedded.end.ruby",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.begin.ruby",
        "punctuation.definition.template-expression",
        "entity.name.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#F43F5E"
      }
    },
    {
      "name": "Sith Red Keywords",
      "scope": [
        "storage",
        "keyword",
        "meta.link",
        "meta.image",
        "markup.italic",
        "source.js support.type",
        "source.ts support.type",
        "source.tsx support.type",
        "source.jsx support.type"
      ],
      "settings": {
        "foreground": "#FF4057"
      }
    },
    {
      "name": "Blue",
      "scope": [
        "string.regexp",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E7ADCD"
      }
    },
    {
      "name": "Red",
      "scope": [
        "constant",
        "support.class",
        "keyword.operator",
        "support.constant",
        "text.html.markdown string",
        "source.css support.function",
        "source.php support.function",
        "support.function.magic.python",
        "entity.other.attribute-name.id",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    },
    {
      "name": "Sith Coral Strings",
      "scope": [
        "string",
        "text.html.php string",
        "markup.inline.raw",
        "markup.inserted",
        "punctuation.definition.string",
        "punctuation.definition.markdown",
        "text.html meta.embedded source.js string",
        "text.html.php punctuation.definition.string",
        "text.html meta.embedded source.js punctuation.definition.string",
        "text.html punctuation.definition.string",
        "text.html string"
      ],
      "settings": {
        "foreground": "#FF9A9E"
      }
    },
    {
      "name": "Font Underline",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "property": "#FFB09E",
    "property.readonly": "#FFB09E",
    "property.declaration": "#FFB09E",
    "variable": "#FF536B",
    "variable.readonly": "#FF536B",
    "variable.defaultLibrary": "#FF536B",
    "parameter": "#FF536B",
    "function": "#F7CCD5",
    "function.defaultLibrary": "#F7CCD5",
    "method": "#F7CCD5",
    "class": "#F7CCD5",
    "type": "#F7CCD5",
    "interface": "#F7CCD5",
    "enum": "#F7CCD5",
    "enumMember": "#FFB09E",
    "keyword": "#FF4057",
    "string": "#FF9A9E",
    "number": "#FFB09E",
    "operator": "#FF6B6B",
    "comment": "#9C7D86"
  }
}
